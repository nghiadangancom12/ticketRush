# =========================================
# TicketRush Environment Variables
# =========================================

# 🌐 Frontend URL (Important for CORS)
FRONTEND_URL=http://localhost:5173

# 🔙 Backend URLs & Ports
BACKEND_URL=http://localhost:3000
PORT=3000
QUEUE_PORT=3001
SOCKET_PORT=3002
BOOKING_SERVICE_URL=http://localhost:3040

# 🔑 JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_COOKIE_EXPIRES_IN=1

# 📊 Environment
NODE_ENV=development

# 🗄️ Database-per-Service (4 PostgreSQL Databases)
# Monolith fallback (giữ cho app.js backward compatibility)
DATABASE_URL=postgresql://user:password@localhost:5433/auth_db

# Auth DB (users)
AUTH_DATABASE_URL=postgresql://user:password@localhost:5433/auth_db
# Event Catalog DB (events, categories, zones)
CATALOG_DATABASE_URL=postgresql://user:password@localhost:5434/catalog_db
# Booking DB (seats, orders, tickets)
BOOKING_DATABASE_URL=postgresql://user:password@localhost:5435/booking_db
# Analytics DB (analytics_order_summary)
ANALYTICS_DATABASE_URL=postgresql://user:password@localhost:5436/analytics_db

# 📧 Email Configuration (Optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# 💳 Payment Gateway (Optional)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# 🔐 Encryption Keys (Optional)
ENCRYPTION_KEY=your-encryption-key

# =========================================
# Production Setup
# =========================================

# Uncomment và sửa khi chạy production:
# FRONTEND_URL=https://app.ticketrush.com
# BACKEND_URL=https://api.ticketrush.com
# NODE_ENV=production
# JWT_COOKIE_EXPIRES_IN=7
