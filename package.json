{
  "devDependencies": {
    "cross-env": "^10.1.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.3.0",
    "prisma": "^7.6.0",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.0",
    "express-xss-sanitizer": "^2.0.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "xss-clean": "^0.1.4",
    "yamljs": "^0.3.0",
    "zod": "^4.3.6"
  },
  "scripts": {
    "start:dev": "cross-env NODE_ENV=development nodemon server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "test": "jest --detectOpenHandles",
    "seed": "node prisma/seed.js",
    "seed:k6": "node prisma/seed-k6.js",
    "seed:k6:neon": "cross-env K6_USER_COUNT=600 node prisma/seed-k6.js",
    "db:k6:postgres:migrate": "cross-env DATABASE_URL=postgresql://user:password@localhost:5432/ticketrush DIRECT_URL=postgresql://user:password@localhost:5432/ticketrush npx prisma migrate deploy",
    "seed:k6:postgres": "cross-env DATABASE_URL=postgresql://user:password@localhost:5432/ticketrush DIRECT_URL=postgresql://user:password@localhost:5432/ticketrush K6_USER_COUNT=600 node prisma/seed-k6.js",
    "k6:stack:up": "docker compose -f docker-compose.k6.yml up -d --build",
    "k6:stack:down": "docker compose -f docker-compose.k6.yml down",
    "k6:postgres:stack:up": "docker compose -f docker-compose.k6.yml up -d --build",
    "k6:postgres:stack:down": "docker compose -f docker-compose.k6.yml down",
    "k6:seat": "k6 run tests/k6/rush-seat-contention.js",
    "k6:queue": "k6 run tests/k6/rush-queue-admission.js",
    "k6:mixed": "k6 run tests/k6/rush-mixed-e2e.js",
    "k6:race": "k6 run tests/k6/race-condition.js",
    "k6:stress": "k6 run tests/k6/stress-test.js",
    "k6:neon:stack:up": "docker compose -f docker-compose.k6.neon.yml up -d --build",
    "k6:neon:stack:down": "docker compose -f docker-compose.k6.neon.yml down",
    "k6:neon:smoke": "k6 run -e K6_CONFIG=tests/k6/config.neon.json tests/k6/neon-smoke.js",
    "k6:final:neon:read": "k6 run -e K6_CONFIG=tests/k6/config.final.neon.json -e BENCHMARK_MODE=read tests/k6/final-capacity-benchmark.js",
    "k6:final:neon:write": "k6 run -e K6_CONFIG=tests/k6/config.final.neon.json -e BENCHMARK_MODE=write tests/k6/final-capacity-benchmark.js",
    "k6:final:neon:mixed": "k6 run -e K6_CONFIG=tests/k6/config.final.neon.json -e BENCHMARK_MODE=mixed tests/k6/final-capacity-benchmark.js",
    "k6:final:postgres:read": "k6 run -e K6_CONFIG=tests/k6/config.final.postgres.json -e BENCHMARK_MODE=read tests/k6/final-capacity-benchmark.js",
    "k6:final:postgres:write": "k6 run -e K6_CONFIG=tests/k6/config.final.postgres.json -e BENCHMARK_MODE=write tests/k6/final-capacity-benchmark.js",
    "k6:final:postgres:mixed": "k6 run -e K6_CONFIG=tests/k6/config.final.postgres.json -e BENCHMARK_MODE=mixed tests/k6/final-capacity-benchmark.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["./tests/setup.js"]
  }
}
