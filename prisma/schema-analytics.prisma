generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-analytics"
}

datasource db {
  provider = "postgresql"
}

/// Bảng tổng hợp denormalized cho Admin Dashboard.
model analytics_order_summary {
  order_id       String              @id @db.Uuid
  user_id        String              @db.Uuid
  user_email     String              @db.VarChar(255)
  user_gender    gender_enum?
  user_dob       DateTime?           @db.Date
  event_id       String              @db.Uuid
  event_title    String              @db.VarChar(255)
  category_name  String?             @db.VarChar(100)
  total_amount   Decimal             @db.Decimal(12, 2)
  order_status   order_status_enum
  created_at     DateTime            @db.Timestamptz(6)

  @@index([user_id], map: "idx_analytics_user")
  @@index([event_id], map: "idx_analytics_event")
  @@index([category_name], map: "idx_analytics_category")
  @@index([order_status], map: "idx_analytics_status")
}

enum gender_enum {
  MALE
  FEMALE
  OTHER
}

enum order_status_enum {
  PENDING
  PAID
  CANCELLED
}
