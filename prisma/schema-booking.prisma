generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-booking"
}

datasource db {
  provider = "postgresql"
}

/// Bảng seats đã denormalize: snapshot zone_name, zone_price, event_id
/// để booking_db tự đủ dữ liệu, không cần JOIN xuyên sang catalog_db.
model seats {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zone_id     String            @db.Uuid
  zone_name   String            @db.VarChar(100)
  zone_price  Decimal           @db.Decimal(12, 2)
  event_id    String            @db.Uuid
  row_label   String            @db.VarChar(10)
  seat_number Int
  status      seat_status_enum? @default(AVAILABLE)
  locked_by   String?           @db.Uuid
  locked_at   DateTime?         @db.Timestamptz(6)
  tickets     tickets?

  @@unique([zone_id, row_label, seat_number])
  @@index([status, locked_at], map: "idx_seats_locked_status")
  @@index([zone_id, row_label, seat_number], map: "idx_seats_matrix")
  @@index([zone_id, status], map: "idx_seats_zone_status")
  @@index([event_id, status], map: "idx_seats_event_status")
}

/// Bảng orders đã denormalize: snapshot event_title, category_name, user_email
/// để giao dịch tài chính giữ nguyên tính bất biến và phục vụ analytics.
model orders {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String             @db.Uuid
  event_id       String             @db.Uuid
  event_title    String             @db.VarChar(255)
  category_name  String?            @db.VarChar(100)
  user_email     String             @db.VarChar(255)
  total_amount   Decimal            @db.Decimal(12, 2)
  status         order_status_enum? @default(PENDING)
  created_at     DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?          @default(now()) @db.Timestamptz(6)
  tickets        tickets[]

  @@index([user_id], map: "idx_orders_user")
  @@index([event_id], map: "idx_orders_event")
}

model tickets {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id  String              @db.Uuid
  seat_id   String              @unique @db.Uuid
  qr_code   String              @unique @db.VarChar(255)
  issued_at DateTime?           @default(now()) @db.Timestamptz(6)
  status    ticket_status_enum? @default(UNUSED)
  orders    orders              @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seats     seats               @relation(fields: [seat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum seat_status_enum {
  AVAILABLE
  LOCKED
  SOLD
}

enum order_status_enum {
  PENDING
  PAID
  CANCELLED
}

enum ticket_status_enum {
  UNUSED
  CHECKED_IN
  REVOKED
}
